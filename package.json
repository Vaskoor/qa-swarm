{
  "name": "qa-swarm",
  "version": "0.1.0",
  "private": true,
  "description": "QA-Swarm — an open-source swarm of AI agents that explore apps, generate tests, run them, triage failures, file bugs, and build regression suites.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "typecheck": "tsc -b packages/core packages/cli --force",
    "dev": "tsx packages/cli/src/index.ts",
    "swarm": "tsx packages/cli/src/index.ts",
    "api": "tsx apps/api/src/server.ts",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:regression": "playwright test tests/regression",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@langchain/core": "^0.3.19",
    "@langchain/langgraph": "^0.2.24",
    "@langchain/openai": "^0.3.14",
    "@langchain/anthropic": "^0.3.9",
    "@qdrant/js-client-rest": "^1.12.0",
    "@playwright/test": "^1.49.0",
    "playwright": "^1.49.0",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.76.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.16.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}