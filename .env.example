# --- LLM providers (set at least one for real reasoning) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector memory (optional; falls back to embedded in-process store) ---
QDRANT_URL=http://localhost:6333

# --- Database for state assertions (optional, read-only) ---
DATABASE_URL=postgres://qa:qa@localhost:5432/qa

# --- Issue filing (optional; falls back to local markdown files) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_PROJECT_KEY=QA
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- Performance budgets ---
QA_TTFB_BUDGET_MS=800
QA_PAYLOAD_BUDGET_KB=2048
QA_REQUEST_BUDGET=60